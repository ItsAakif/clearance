# ==================== SERVER ====================
PORT=3001
NODE_ENV=development

# ==================== DATABASE ====================
DATABASE_URL="postgresql://user:password@localhost:5432/clearance?schema=public"

# ==================== AUTH ====================
JWT_SECRET="change-this-to-a-random-64-char-string"

# ==================== CORS / CLIENT ====================
CLIENT_URL="http://localhost:8080"
VITE_API_URL=http://localhost:3001/api

# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==================== REGISTRATION ====================
ALLOW_REGISTRATION="true"
ADMIN_EMAILS=""

# ==================== FEATURE FLAGS ====================
VITE_ENABLE_PUBLIC_SCAN=true
VITE_ENABLE_AI_FEATURES=true

# ==================== ANALYTICS (optional) ====================
VITE_GA_MEASUREMENT_ID=
VITE_POSTHOG_KEY=

# ==================== API URL ====================
API_URL=http://localhost:3001

# KEY_ENCRYPTION_SECRET=""  # optional; defaults to access-password-derived key
