# Clearance environment template.
# Copy to `.env` at the REPO ROOT and fill in values:  cp .env.example .env
# The backend reads these from the process environment (docker compose passes
# the root `.env` through; see docker-compose.yml). `./backend/.env` is NOT used.
#
# Variable list below mirrors exactly what the backend reads:
#   - validated vars: backend/src/config/env.ts
#   - V2_* flags:     backend/src/config/flags.ts (defaults false) and
#     src/lib/flags.ts (same key names)
#   - DATABASE_URL:   backend/src/lib/prisma.ts (Prisma datasource)
#   - POSTGRES_*:     docker-compose.yml `db` service only
#   - *_API_KEY / model overrides / *_URL: backend/src/ai/keyManager.ts,
#     backend/src/jobSources/* (optional BYOK fallbacks; Settings UI also works)
#   - VITE_*:         frontend build (src/services/api/client.ts reads VITE_API_URL)
# Never commit a real `.env` with real secrets.

# ==================== SERVER ====================
PORT=3001
NODE_ENV=development

# ==================== DATABASE ====================
# Local embedded Postgres (default — no Docker needed).
# Terminal 1: cd backend && npm run db:local
# Terminal 2: cd backend && npm run dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/clearance?schema=public"
# Hosted alternative (e.g. Neon) — comment the line above and uncomment this to switch back:
# DATABASE_URL="postgresql://user:password@your-host.neon.tech/neondb?sslmode=require"
# Pool tuning for hosted poolers (Supavisor/PgBouncer/Neon): idle sockets get
# terminated with FATAL 57P01. Keep the pool small and let checkouts wait.
# The backend appends these defaults when missing, so they are optional here:
#   ?connection_limit=2&pool_timeout=20&connect_timeout=10
# Example full URL:
# DATABASE_URL="postgresql://user:password@your-host.neon.tech/neondb?sslmode=require&connection_limit=2&pool_timeout=20&connect_timeout=10"

# ==================== POSTGRES (docker compose `db` service only) ====================
# Optional — the compose file defaults each of these when unset.
# They must match the credentials embedded in DATABASE_URL when you use compose.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=clearance

# ==================== ACCESS PASSWORD (REQUIRED) ====================
# The single shared password that gates login (backend/src/config/env.ts).
# The backend ships with the placeholder default `CHANGEME` so that
# `config`/`build` validate on a clean clone — but it REFUSES to boot in
# production until this is changed (assertRequiredRuntimeConfig), and warns in
# development. Set a long random value before any production or shared deploy.
CLEARANCE_ACCESS_PASSWORD=CHANGEME

# ==================== KEY ENCRYPTION (RECOMMENDED) ====================
# BYOK provider keys are encrypted at rest with AES-256-GCM. When this is
# unset, the encryption key is derived from CLEARANCE_ACCESS_PASSWORD — so
# changing the access password ORPHANS previously stored keys (they can no
# longer be decrypted). Set an explicit stable value to survive password
# rotations (backend/src/lib/crypto.ts).
# KEY_ENCRYPTION_SECRET=""

# ==================== CORS / CLIENT ====================
CLIENT_URL="http://localhost:8080"
VITE_API_URL=http://localhost:3001/api
# Standalone landing build: set `VITE_APP_URL` to the app origin (for example
# https://app.clearance.example) so the landing's "open the app" links leave the
# marketing host. Leave empty for the same-origin monorepo deployment. Vite
# bakes it at build time, so rebuild after changing it.
VITE_APP_URL=
# Compose frontend service: the browser calls the backend DIRECTLY, so
# VITE_API_URL stays the host-reachable URL above (not http://backend:3001).
# Vite bakes VITE_* at build time — after changing any VITE_* value, rebuild:
#   docker compose up --build
# The built bundle is served by the compose `frontend` service on :8080
# (matches CLIENT_URL above; no secrets are baked into the image — BYOK keys
# are entered in the app Settings page).

# ==================== API URL ====================
API_URL=http://localhost:3001

# ==================== EMAIL (optional) ====================
# Transactional mail is only sent when the full SMTP set is present
# (backend/src/lib/mailer.ts). EMAIL_FROM defaults to noreply@clearance.app.
# EMAIL_FROM=noreply@clearance.app
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ==================== FEATURE FLAGS ====================
# Legacy frontend switches (documented for the compose `frontend` service; see
# docker-compose.yml). Not read by application code.
VITE_ENABLE_PUBLIC_SCAN=true
VITE_ENABLE_AI_FEATURES=true

# ==================== V2 FEATURE FLAGS (all default OFF) ====================
# The V2 rollout switches (backend/src/config/flags.ts + src/lib/flags.ts). The
# SAME env key name is read by BOTH runtimes, so set it once here and the server
# and the browser agree. Vite bakes these into the bundle at build time, so
# flipping one for a deployed frontend needs a rebuild (`docker compose up --build`).
#
# EVERY flag defaults to false. With none of them set the app is byte-identical
# to the pre-flag build.
#
# A flag turns ON only for the two exact, case-sensitive spellings `true` and
# `on` - the spellings backend/src/config/env.ts already accepts (`true` is the
# CAMOUFOX_ENABLED convention, `on` is the SEARCH_ATTRIBUTION convention).
# Anything else - `TRUE`, `ON`, `On`, `yes`, `1`, `off`, empty, garbage - leaves
# the flag OFF, so an operator typo can never silently enable a V2 surface.
#
# V2_RESUME_STUDIO - the V2 Resume Studio UI and the new API groups.
V2_RESUME_STUDIO=false
# V2_DISABLE_FREE_AI_GENERATION - retire the fabricating endpoints
#   POST /ai/generate-resume and POST /ai/build-from-jd (no invented experience).
V2_DISABLE_FREE_AI_GENERATION=false
# V2_TYPST_RENDER - the Typst/A4 render tier (replaces the Letter export path).
V2_TYPST_RENDER=false

# ==================== ANALYTICS (optional) ====================
VITE_GA_MEASUREMENT_ID=
VITE_POSTHOG_KEY=

# ==================== JOB AGGREGATOR KEYS (optional; BYOK also works via Settings) ====================
# Adzuna: appId + appKey. Env pair, or store "appId:appKey" as one key in Settings.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# USAJobs: your email address + the key from https://developer.usajobs.gov/apirequest/
# USAJOBS_EMAIL=
# USAJOBS_API_KEY=
# Reed: key from https://www.reed.co.uk/developers/jobseeker
# REED_API_KEY=
# Findwork: token from https://findwork.dev/developers/
# FINDWORK_API_KEY=
# Retired: CAREERJET_AFFID and JOOBLE_API_KEY are no longer read by the backend. If you
# still have those keys stored in Settings they remain listed and deletable.

# ==================== LLM / SEARCH KEYS (optional; BYOK also works via Settings) ====================
# The backend also accepts per-provider env fallback keys (backend/src/ai/keyManager.ts):
# <PROVIDER>_API_KEY (plus <PROVIDER>_API_KEY_1..20 for rotation), where PROVIDER is
# one of groq, openai, openrouter, gemini, anthropic, zai, deepseek, mistral,
# together, fireworks, azure-openai, ollama, lmstudio — or tavily / exa / rapidapi /
# firecrawl / crawl4ai. Tavily additionally honors TAVILY_API_KEY, Exa honors EXA_API_KEY.
# Database-stored Settings keys take precedence; env keys are fallback only.
# TAVILY_API_KEY=
# EXA_API_KEY=

# ==================== SCRAPING BACKEND KEYS (optional; BYOK also works via Settings) ====================
# RapidAPI key for the hard anti-bot boards (LinkedIn/Indeed/ZipRecruiter/Glassdoor/
# Bayt). Subscribe to the canonical JSearch listing and use the path it currently
# serves:
#   JSearch             https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch                    GET /search-v2
#   PullAPI LinkedIn    https://rapidapi.com/pullapi-pullapi-default/api/linkedin-scraper-api6   GET /linkedin/jobs
#   PullAPI Indeed      https://rapidapi.com/pullapi-pullapi-default/api/indeed-scraper-api2     GET /indeed/search
# Confirm the X-RapidAPI-Host shown in each listing's Code Snippet matches the listing
# you subscribed to; a mismatched host returns 403/404.
# RAPIDAPI_API_KEY=
# Firecrawl (self-hosted or cloud) for YC/Wellfound/Instahyre/Sprout/Google.
# For env-sourced keys, FIRECRAWL_URL is the base URL (DB-stored keys keep the
# URL in the key label instead); the key itself goes in Settings or FIRECRAWL_API_KEY.
# FIRECRAWL_URL=http://localhost:3002/v2
# Crawl4AI (self-hosted) alternative to Firecrawl; same coverage, same key-in-Settings pattern.
# CRAWL4AI_URL=http://localhost:3002/v2

# ==================== LEGACY LLM MODEL OVERRIDES ====================
# Per-feature fallback model IDs, honored only when no per-provider DB override
# (Settings → AI Models) is set. Prefer the Settings UI; these remain a coarse,
# provider-agnostic escape hatch.
# ATS_MODEL=""
# ATS_FALLBACK_MODEL=""
# RESUME_TAILOR_MODEL=""
# RESUME_PARSE_MODEL=""
# PROFILE_PARSE_MODEL=""

# ==================== BROWSER TIER (optional; wave 6, ADR-029) ====================
# Last-resort, deep-mode-only reader for pages no cheaper tier could read.
# Default compose stays slim: with these unset the tier reports UNAVAILABLE
# and deep search continues with the cheaper tiers (backend/src/browser/).
# Spelling follows the T720 probe: the automation library is `camoufox-js`.
# Enable only on the full image / sidecar shape that actually has the engine:
#   npm i camoufox-js && npx camoufox-js fetch
# (engine cache dir is the tool's own CAMOUFOX_INSTALL_DIR, not a backend var).
# CAMOUFOX_ENABLED=false
# Remote shape (separate browser service instead of in-process library):
# CAMOUFOX_WS_ENDPOINT=ws://browser:3131
# Per-call navigation/operation budget in ms (bounded by the client):
# CAMOUFOX_NAV_TIMEOUT_MS=30000
# Bounds enforced STRUCTURALLY by backend/src/browser/pool.ts (N6: no
# code path bypasses them). Over-cap URLs are truncated/reported, never
# silently dropped; cancel() stops queued work and drains in-flight.
# Lower any of these to tighten a self-hosted deployment:
# CAMOUFOX_MAX_CONCURRENCY=2
# CAMOUFOX_MAX_URLS_PER_RUN=20
# CAMOUFOX_MAX_QUEUE_DEPTH=50

# ==================== RENDER TIER (V2; T1043, ADR-042/044) ====================
# Typst renders run in a sandboxed container created by the render BROKER
# (backend/src/render/broker/), never by the API process. The API talks to
# the broker over a unix socket (preferred) or a LOOPBACK-ONLY http URL, with
# a shared secret header. The API process never holds a Docker socket.
# Nothing below is read unless V2_TYPST_RENDER=true; with the flag off
# POST /resumes/:id/render keeps returning its pre-existing 404.
#
# Quotas (policy 10.2). TUNABLE LOWER, NEVER HIGHER: a value above the
# default is REFUSED AT BOOT with a fixed message. These are containment
# properties, not capacity hints - a raised cap silently weakens a policy
# mandate, so raising one needs a measured reason AND a policy change.
# RENDER_MAX_CONCURRENCY=2
# RENDER_MAX_CONCURRENCY_PER_USER=1
# Queue depth; beyond it the broker answers 429 RENDER_BUSY.
# RENDER_QUEUE_DEPTH=8
# Per-user renders per minute, enforced by a dedicated express-rate-limit
# limiter keyed on req.user.id (backend/src/app.ts, policy 10.2's last row).
# Default 10; the compose backend sets 60 so a Studio mount + arrivals fits the budget.
RENDER_PER_USER_PER_MINUTE=60
# RENDER/TRANSPORT budget for ONE render, in ms - the budget the port
# ENFORCES on the request (the compile plan's own timeout stays pinned by
# render/sandbox.ts and is NOT settable here). Also TUNABLE LOWER, never
# higher: the ceiling is the policy's 10000 ms, the same number
# render/sandbox.ts pins into every compile plan, so this knob can never
# exceed the container's own wall clock. The broker TRANSPORT budget is
# this plus the 2 s kill grace plus a staging/extraction margin, so a
# lowered value never truncates a job inside its own policy.
# RENDER_TIMEOUT_MS=10000
#
# Artifact storage (ADR-041 D2 / ADR-044 D2). Postgres stores METADATA
# ONLY - storageKey, sha256, byteSize, mimeType - and the bytes live behind
# this port. `fs` is the only implemented kind; `s3` is a fail-closed seam
# that throws STORAGE_UNAVAILABLE rather than silently using local disk.
# RENDER_STORAGE_KIND=fs
# Root for the fs store. Unset defaults to backend/.artifacts OUTSIDE
# production; in production an unset root is a boot failure, not a surprise
# directory in the image. Mounted rw on the backend service ONLY - never on
# the worker, never on pgdata (policy 4.5's bind allowlist is three entries,
# all under backend/typst/).
# RENDER_STORAGE_ROOT=./.artifacts
#
# Broker transport (ADR-044 D1). The token is the BROKER's boot requirement
# (an unauthenticated render broker is a public RCE queue), not this API's;
# with no token the port answers 503 render_broker_unavailable rather than
# crashing. A url must be LOOPBACK - the client refuses anything else,
# because a broker on a routable address behind a shared-secret header is
# remote code execution wearing an auth header.
# RENDER_BROKER_SOCKET=/run/clearance-render/broker.sock
# RENDER_BROKER_URL=http://127.0.0.1:3010
# RENDER_BROKER_TOKEN=change-me-render-broker-token
#
#
# Catalogue snapshot feed used by the Settings "Sync catalogue" button and
# POST /catalogue/sync. Unset defaults to the latest GitHub release asset.
# https is required in production; loopback http is accepted in development
# so a locally served snapshot can be tested.
# CATALOGUE_FEED_URL=https://github.com/ItsAakif/clearance/releases/latest/download/catalogue.jsonl.gz
#
# There is deliberately NO spool key in this file. The contract named
# RENDER_BROKER_SPOOL_DIR, but the BROKER process reads
# RENDER_BROKER_SPOOL_ROOT (backend/src/render/broker/index.ts) and the
# API never materialises the container's /out, so the backend-side name
# was dead config. One key, one owner: set RENDER_BROKER_SPOOL_ROOT on the
# render-broker service (docker-compose.yml does), and nowhere else.
